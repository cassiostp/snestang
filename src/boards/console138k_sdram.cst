// Bound SDRAM fabric capture registers next to their DQ pins, one
// small group per DQ bit so the five flops a pin feeds share one short
// route tree at the east-edge columns. Band rows follow the pin's IOR
// site along bank 2 (measured pin->flop routes of 0.7-1.5 ns at these
// columns, against 2.1-3.8 ns from the old shared C[160:175] region).
// Physical placement only; all data/ack edges and SDC delays stay put.
// Do not widen these groups to whole hierarchies: a GROUP over
// "main/SNES/CPU/*" (thousands of objects incl. BSRAM) stalls the CST
// reader in PnR (exp/gsu2-cpu-near).
GROUP cap_dq0 = { "sdram/cpu_port0_0_s*" "sdram/cpu_port1_0_s*" "sdram/cpu2_dout_0_s*" "sdram/aram_dout_0_s*" "sdram/dq_oen_0_s*" }; // DQ0 IOR2[B]
GRP_LOC cap_dq0 R[5:12]C[172:181];
GROUP cap_dq1 = { "sdram/cpu_port0_1_s*" "sdram/cpu_port1_1_s*" "sdram/cpu2_dout_1_s*" "sdram/aram_dout_1_s*" "sdram/dq_oen_1_s*" }; // DQ1 IOR2[A]
GRP_LOC cap_dq1 R[9:16]C[172:181];
GROUP cap_dq2 = { "sdram/cpu_port0_2_s*" "sdram/cpu_port1_2_s*" "sdram/cpu2_dout_2_s*" "sdram/aram_dout_2_s*" "sdram/dq_oen_2_s*" }; // DQ2 IOR8[B]
GRP_LOC cap_dq2 R[17:24]C[172:181];
GROUP cap_dq3 = { "sdram/cpu_port0_3_s*" "sdram/cpu_port1_3_s*" "sdram/cpu2_dout_3_s*" "sdram/aram_dout_3_s*" "sdram/dq_oen_3_s*" }; // DQ3 IOR8[A]
GRP_LOC cap_dq3 R[20:27]C[172:181];
GROUP cap_dq4 = { "sdram/cpu_port0_4_s*" "sdram/cpu_port1_4_s*" "sdram/cpu2_dout_4_s*" "sdram/aram_dout_4_s*" "sdram/dq_oen_4_s*" }; // DQ4 IOR17[B]
GRP_LOC cap_dq4 R[30:37]C[172:181];
GROUP cap_dq5 = { "sdram/cpu_port0_5_s*" "sdram/cpu_port1_5_s*" "sdram/cpu2_dout_5_s*" "sdram/aram_dout_5_s*" "sdram/dq_oen_5_s*" }; // DQ5 IOR17[A]
GRP_LOC cap_dq5 R[32:39]C[172:181];
GROUP cap_dq6 = { "sdram/cpu_port0_6_s*" "sdram/cpu_port1_6_s*" "sdram/cpu2_dout_6_s*" "sdram/aram_dout_6_s*" "sdram/dq_oen_6_s*" }; // DQ6 IOR15[B]
GRP_LOC cap_dq6 R[26:33]C[172:181];
GROUP cap_dq7 = { "sdram/cpu_port0_7_s*" "sdram/cpu_port1_7_s*" "sdram/cpu2_dout_7_s*" "sdram/aram_dout_7_s*" "sdram/dq_oen_7_s*" }; // DQ7 IOR15[A]
GRP_LOC cap_dq7 R[28:35]C[172:181];
GROUP cap_dq8 = { "sdram/cpu_port0_8_s*" "sdram/cpu_port1_8_s*" "sdram/cpu2_dout_8_s*" "sdram/aram_dout_8_s*" "sdram/dq_oen_8_s*" }; // DQ8 IOR44[A]
GRP_LOC cap_dq8 R[37:44]C[172:181];
GROUP cap_dq9 = { "sdram/cpu_port0_9_s*" "sdram/cpu_port1_9_s*" "sdram/cpu2_dout_9_s*" "sdram/aram_dout_9_s*" "sdram/dq_oen_9_s*" }; // DQ9 IOR44[B]
GRP_LOC cap_dq9 R[39:46]C[172:181];
GROUP cap_dq10 = { "sdram/cpu_port0_10_s*" "sdram/cpu_port1_10_s*" "sdram/cpu2_dout_10_s*" "sdram/aram_dout_10_s*" "sdram/dq_oen_10_s*" }; // DQ10 IOR40[A]
GRP_LOC cap_dq10 R[32:39]C[172:181];
GROUP cap_dq11 = { "sdram/cpu_port0_11_s*" "sdram/cpu_port1_11_s*" "sdram/cpu2_dout_11_s*" "sdram/aram_dout_11_s*" "sdram/dq_oen_11_s*" }; // DQ11 IOR40[B]
GRP_LOC cap_dq11 R[32:39]C[172:181];
GROUP cap_dq12 = { "sdram/cpu_port0_12_s*" "sdram/cpu_port1_12_s*" "sdram/cpu2_dout_12_s*" "sdram/aram_dout_12_s*" "sdram/dq_oen_12_s*" }; // DQ12 IOR20[A]
GRP_LOC cap_dq12 R[47:54]C[172:181];
GROUP cap_dq13 = { "sdram/cpu_port0_13_s*" "sdram/cpu_port1_13_s*" "sdram/cpu2_dout_13_s*" "sdram/aram_dout_13_s*" "sdram/dq_oen_13_s*" }; // DQ13 IOR20[B]
GRP_LOC cap_dq13 R[47:54]C[172:181];
GROUP cap_dq14 = { "sdram/cpu_port0_14_s*" "sdram/cpu_port1_14_s*" "sdram/cpu2_dout_14_s*" "sdram/aram_dout_14_s*" "sdram/dq_oen_14_s*" }; // DQ14 IOR22[A]
GRP_LOC cap_dq14 R[24:31]C[172:181];
GROUP cap_dq15 = { "sdram/cpu_port0_15_s*" "sdram/cpu_port1_15_s*" "sdram/cpu2_dout_15_s*" "sdram/aram_dout_15_s*" "sdram/dq_oen_15_s*" }; // DQ15 IOR22[B]
GRP_LOC cap_dq15 R[24:31]C[172:181];
// The BSRAM byte register is fed (through its byte mux) by DQ[j] and
// DQ[j+8]; keep it in the same east columns between the two clusters.
GROUP cap_bsram = { "sdram/bsram_dout_reg*" };
GRP_LOC cap_bsram R[28:45]C[172:181];
// The per-pin dq_oen register joins its pin's group: it never packs
// into the IOB TRIREG in practice (I/O FF count is unchanged with or
// without it), and left unbound the placer parks it mid-device,
// which made dq_oen->DQ the worst pin path (+0.062 ns).
// Anchor the BSRAM read cone's stable-named pieces in the central
// columns. The BSRAM lane keeps its true 31 ns window (its age at the
// S-CPU sample is not bounded under save-channel contention), and
// unanchored the placer scatters this cone across the full width
// (C57..C179 in one build, -2.279 ns; C88..C124 in another, +1.5 ns).
// Groups name only LUT/FF objects from RTL signal names (BSRAM_Q mux,
// P65_DI mux, the 65C816 DB mux and P/PCr/X/Y register cones) -- no
// hierarchy wildcards, no BSRAM/DSP objects.
GROUP bsram_q_mux = { "BSRAM_Q*" };
GRP_LOC bsram_q_mux R[25:60]C[105:140];
// CST reader stall bisect (all at "Reading constraint file",
// gw_sh spinning, builds killed): GROUP patterns with a deep
// hierarchy prefix stall -- "main/SNES/CPU/*" (exp/gsu2-cpu-near),
// "main/SNES/CPU/P65C816/{P_*,DB*,...}" cone LUTs, endpoint flops
// via mid-string "*_s0", and trailing-* "main/SNES/CPU/P65_DI*" +
// "main/SNES/CPU/P65C816/DB*" alike. Top-level ("BSRAM_Q*") and
// one-level ("sdram/...") patterns parse in seconds. Do not add
// deep-hierarchy GROUP patterns to this file; use exact-name
// INS_LOC if a deep object ever needs anchoring.
// Endpoint registers of the BSRAM->S-CPU cone, anchored by exact
// name (INS_LOC is an exact lookup and does not stall the reader
// the way deep-hierarchy GROUP patterns do). The place_option-2
// perturbation build (exp/sdramrob-seed) put this cone at
// -0.194 ns with the endpoints unanchored, vs +1.78 ns at the
// production place_option 3 -- anchor the PC/P/X/Y registers in
// the same central columns as the BSRAM_Q mux so the cone tail
// cannot drift east/west. Only flops observed in timing reports
// are listed; a renamed flop fails the build loudly (CT1135),
// it cannot silently lose the anchor.
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_0_s0" R40C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_1_s0" R41C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_2_s0" R42C[105:150];
INS_LOC "main/SNES/CPU/P65C816/P_0_s0" R42C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_3_s0" R43C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_4_s0" R44C[105:150];
INS_LOC "main/SNES/CPU/P65C816/P_1_s0" R44C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_5_s0" R45C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_6_s0" R46C[105:150];
INS_LOC "main/SNES/CPU/P65C816/P_2_s0" R46C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_7_s0" R47C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_8_s0" R48C[105:150];
INS_LOC "main/SNES/CPU/P65C816/P_7_s0" R48C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_9_s0" R49C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_10_s0" R50C[105:150];
INS_LOC "main/SNES/CPU/P65C816/X_15_s0" R50C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_11_s0" R51C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_12_s0" R52C[105:150];
INS_LOC "main/SNES/CPU/P65C816/Y_15_s0" R52C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_13_s0" R53C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_14_s0" R54C[105:150];
INS_LOC "main/SNES/CPU/P65C816/AddrGen/PCr_15_s0" R55C[105:150];
